{
  "name": "codex-quota-vscode",
  "displayName": "Codex Quota",
  "description": "%main.description%",
  "version": "0.1.9",
  "publisher": "jyongli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jyongli/codex-quota-vscode.git"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "quota",
    "status bar"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%main.trust%"
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codexQuota.menu",
        "title": "%menu%"
      },
      {
        "command": "codexQuota.refresh",
        "title": "%refresh%"
      },
      {
        "command": "codexQuota.togglePosition",
        "title": "%togglePosition%"
      },
      {
        "command": "codexQuota.showAccount",
        "title": "%showAccount%"
      },
      {
        "command": "codexQuota.showDiagnostics",
        "title": "%showDiagnostics%"
      },
      {
        "command": "codexQuota.selectLanguage",
        "title": "%selectLanguage%"
      }
    ],
    "configuration": {
      "title": "Codex Quota",
      "properties": {
        "codexQuota.statusBarPosition": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right",
          "scope": "window",
          "description": "%statusBarPosition%"
        },
        "codexQuota.cliPath": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "description": "%cliPath%"
        },
        "codexQuota.codexHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%codexHome%"
        },
        "codexQuota.remoteCliPath": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "description": "%remoteCliPath%",
          "deprecationMessage": "%remoteCliPath.deprecated%"
        },
        "codexQuota.remoteCodexHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%remoteCodexHome%",
          "deprecationMessage": "%remoteCodexHome.deprecated%"
        },
        "codexQuota.refreshIntervalSeconds": {
          "type": "integer",
          "default": 300,
          "minimum": 60,
          "maximum": 3600,
          "scope": "window",
          "description": "%refreshIntervalSeconds%"
        },
        "codexQuota.requestTimeoutSeconds": {
          "type": "integer",
          "default": 60,
          "minimum": 5,
          "maximum": 120,
          "scope": "window",
          "description": "%requestTimeoutSeconds%"
        },
        "codexQuota.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "default": "auto",
          "scope": "window",
          "description": "%language%",
          "enumDescriptions": [
            "%language.auto%",
            "%language.zh-CN%",
            "%language.en%"
          ]
        },
        "codexQuota.showPublicIp": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%showPublicIp%"
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "npm run check && node scripts/build.mjs",
    "compile-tests": "tsc",
    "test": "npm run compile-tests && node scripts/test-unit.mjs",
    "test:bundle": "npm run build && npm run compile-tests && node scripts/test-bundle.mjs",
    "test:native": "npm run compile-tests && node scripts/test-native.mjs",
    "test:vscode": "npm run build && npm run compile-tests && node scripts/test-vscode.cjs",
    "vscode:prepublish": "npm run build",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.7.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
