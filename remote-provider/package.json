{
  "name": "codex-quota-remote",
  "displayName": "Codex Quota Remote",
  "description": "Codex Quota 的远程查询组件；在工作区宿主读取所在机器的 Codex CLI 账号与额度。",
  "version": "0.1.5",
  "publisher": "jyongli",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/jyongli/codex-quota-vscode.git" },
  "engines": { "vscode": "^1.95.0", "node": ">=20" },
  "categories": ["Other"],
  "main": "./dist/remote.js",
  "extensionKind": ["workspace"],
  "activationEvents": ["onCommand:codexQuota.remote.query", "onCommand:codexQuota.remote.cancel"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "额度查询需要执行远程宿主中的 Codex CLI。" },
    "virtualWorkspaces": { "supported": false }
  },
  "contributes": {
    "commands": [
      { "command": "codexQuota.remote.query", "title": "Codex Quota Remote: 查询服务" },
      { "command": "codexQuota.remote.cancel", "title": "Codex Quota Remote: 取消服务请求" }
    ],
    "menus": { "commandPalette": [
      { "command": "codexQuota.remote.query", "when": "false" },
      { "command": "codexQuota.remote.cancel", "when": "false" }
    ] }
  }
}
