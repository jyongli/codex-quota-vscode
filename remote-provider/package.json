{
  "name": "codex-quota-remote",
  "displayName": "Codex Quota Remote",
  "description": "%remote.description%",
  "version": "0.1.7",
  "publisher": "jyongli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jyongli/codex-quota-vscode.git"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/remote.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:codexQuota.remote.query",
    "onCommand:codexQuota.remote.cancel",
    "onCommand:codexQuota.remote.ready"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%remote.trust%"
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codexQuota.remote.query",
        "title": "%remote.query%"
      },
      {
        "command": "codexQuota.remote.cancel",
        "title": "%remote.cancel%"
      },
      {
        "command": "codexQuota.remote.ready",
        "title": "%remote.ready%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codexQuota.remote.query",
          "when": "false"
        },
        {
          "command": "codexQuota.remote.cancel",
          "when": "false"
        },
        {
          "command": "codexQuota.remote.ready",
          "when": "false"
        }
      ]
    }
  }
}
